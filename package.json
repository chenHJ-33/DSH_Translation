{
  "name": "dsh-translate",
  "version": "0.1.0",
  "description": "划词翻译 / Selection translation for DeepSeek Harness — left-drag a word or sentence, click the bubble, or press a hotkey; powered by the Baidu Translate API.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "translate",
    "translation",
    "baidu",
    "划词翻译"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
